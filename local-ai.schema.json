{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gustavonline/omarchy-local-ai/local-ai.schema.json",
  "title": "Omarchy Local AI configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultProfile": { "type": "string" },
    "backend": { "type": "string" },
    "endpoint": { "type": "string" },
    "modelDirectory": { "type": "string" },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "unit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "model": { "type": "string" },
          "variant": { "type": "string" },
          "context": { "type": "string" },
          "description": { "type": "string" },
          "unit": { "type": "string", "minLength": 1 },
          "requiredFiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "bytes": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
