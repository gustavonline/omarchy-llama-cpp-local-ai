#!/usr/bin/env bash
set -euo pipefail

config_file="${OMARCHY_LOCAL_AI_CONFIG:-$HOME/.config/omarchy/local-ai.toml}"
if [[ ${1:-} == --config ]]; then
  config_file="${2:-}"
  shift 2
fi
config_file="${config_file/#\~/$HOME}"

empty_status() {
  jq -nc --arg config "$config_file" '{
    profile:"stopped", state:"inactive", label:"No local runtime configured",
    detail:("Create " + $config), backend:"Local AI", endpoint:"",
    model:"", variant:"", context:"", configFile:$config,
    modelDirectory:"", defaultProfile:"", profiles:[]
  }'
}

[[ -f $config_file ]] || { empty_status; exit 0; }
config_json=$(python3 - "$config_file" <<'PY'
import json
import sys
import tomllib

with open(sys.argv[1], "rb") as handle:
    config = tomllib.load(handle)

profiles = config.get("profiles", [])
if not isinstance(profiles, list):
    raise SystemExit("profiles must be an array of tables")
names = []
for profile in profiles:
    if not isinstance(profile, dict) or not profile.get("name") or not profile.get("service"):
        raise SystemExit("every profile needs name and service")
    names.append(profile["name"])
if len(names) != len(set(names)):
    raise SystemExit("profile names must be unique")
if config.get("default") and config["default"] not in names:
    raise SystemExit("default must match a profile name")

print(json.dumps(config, separators=(",", ":")))
PY
)

expand_path() {
  printf '%s\n' "${1/#\~/$HOME}"
}

profile_ready() {
  local profile_json="$1" encoded file expected unit
  unit=$(jq -r '.service' <<<"$profile_json")
  systemctl --user cat "$unit" >/dev/null 2>&1 || return 1
  while IFS= read -r encoded; do
    [[ -n $encoded ]] || continue
    file=$(base64 -d <<<"$encoded" | jq -r '.path')
    expected=$(base64 -d <<<"$encoded" | jq -r '.bytes // 0')
    file=$(expand_path "$file")
    [[ -f $file ]] || return 1
    (( expected == 0 )) || [[ $(stat -c %s "$file") == "$expected" ]] || return 1
  done < <(jq -r '.files[]? | @base64' <<<"$profile_json")
}

profile_by_id() {
  jq -ce --arg name "$1" '.profiles[] | select(.name == $name)' <<<"$config_json"
}

all_units() {
  jq -r '.profiles[].service' <<<"$config_json" | awk 'NF && !seen[$0]++'
}

active_unit() {
  local unit
  while IFS= read -r unit; do
    if systemctl --user is-active --quiet "$unit"; then
      printf '%s\n' "$unit"
      return 0
    fi
  done < <(all_units)
  return 1
}

status_json() {
  local profiles='[]' active_id="stopped" state="inactive" label="Stopped" detail=""
  local active_model="" active_variant="" active_context=""
  local encoded profile id profile_label model variant context description unit ready unit_state

  while IFS= read -r encoded; do
    [[ -n $encoded ]] || continue
    profile=$(base64 -d <<<"$encoded")
    id=$(jq -r '.name' <<<"$profile")
    profile_label="$id"
    model=$(jq -r '.model // ""' <<<"$profile")
    variant=$(jq -r '.variant // ""' <<<"$profile")
    context=$(jq -r '.context // ""' <<<"$profile")
    description=$(jq -r '[.model, .variant, .context] | map(select(. != null and . != "")) | join(" · ")' <<<"$profile")
    unit=$(jq -r '.service' <<<"$profile")
    ready=false
    profile_ready "$profile" && ready=true
    unit_state=$(systemctl --user is-active "$unit" 2>/dev/null || true)
    [[ $unit_state == active ]] || unit_state=$(systemctl --user is-failed "$unit" 2>/dev/null || true)

    profiles=$(jq -nc \
      --argjson list "$profiles" --arg id "$id" --arg label "$profile_label" \
      --arg model "$model" --arg variant "$variant" --arg context "$context" \
      --arg description "$description" --arg unit "$unit" --arg state "$unit_state" \
      --argjson ready "$ready" \
      '$list + [{id:$id,label:$label,model:$model,variant:$variant,context:$context,description:$description,unit:$unit,state:$state,ready:$ready}]')

    if [[ $unit_state == active ]]; then
      active_id="$id"; state="active"; label="$profile_label"; detail="$description"
      active_model="$model"; active_variant="$variant"; active_context="$context"
    elif [[ $state != active && $unit_state == failed ]]; then
      active_id="$id"; state="failed"; label="$profile_label"; detail="$description"
    fi
  done < <(jq -r '.profiles[] | @base64' <<<"$config_json")

  local backend endpoint default_profile model_directory
  backend=$(jq -r '.backend // "Local runtime"' <<<"$config_json")
  endpoint=$(jq -r '.endpoint // ""' <<<"$config_json")
  default_profile=$(jq -r '.default // ""' <<<"$config_json")
  model_directory=""
  [[ -n $detail ]] || detail="$backend${endpoint:+ · $endpoint}"

  jq -nc \
    --arg profile "$active_id" --arg state "$state" --arg label "$label" \
    --arg model "$active_model" --arg variant "$active_variant" --arg context "$active_context" \
    --arg detail "$detail" --arg backend "$backend" --arg endpoint "$endpoint" \
    --arg configFile "$config_file" \
    --arg modelDirectory "$model_directory" --arg defaultProfile "$default_profile" \
    --argjson profiles "$profiles" \
    '{profile:$profile,state:$state,label:$label,model:$model,variant:$variant,context:$context,detail:$detail,backend:$backend,endpoint:$endpoint,configFile:$configFile,modelDirectory:$modelDirectory,defaultProfile:$defaultProfile,profiles:$profiles}'
}

start_profile() {
  local id="${1:-}" profile unit other
  [[ -n $id ]] || id=$(jq -r '.default // empty' <<<"$config_json")
  [[ -n $id ]] || { printf 'No profile selected and no default configured\n' >&2; exit 2; }
  profile=$(profile_by_id "$id") || { printf 'Unknown local runtime profile: %s\n' "$id" >&2; exit 2; }
  profile_ready "$profile" || { printf 'Profile is not ready: %s\n' "$id" >&2; exit 1; }
  unit=$(jq -r '.service' <<<"$profile")
  while IFS= read -r other; do
    [[ $other == "$unit" ]] || systemctl --user disable --now "$other"
  done < <(all_units)
  systemctl --user enable --now "$unit"
}

case "${1:-status}" in
  status) status_json ;;
  start) start_profile "${2:-}" ;;
  restart)
    if unit=$(active_unit); then systemctl --user restart "$unit"; else start_profile ""; fi
    ;;
  stop)
    while IFS= read -r unit; do systemctl --user disable --now "$unit"; done < <(all_units)
    ;;
  *)
    printf 'Usage: %s [--config PATH] {status|start [PROFILE]|restart|stop}\n' "${0##*/}" >&2
    exit 2
    ;;
esac
