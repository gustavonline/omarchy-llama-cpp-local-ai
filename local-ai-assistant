def mark_ask_failed(suggestion: dict[str, Any], *, direct: bool = False) -> None:
    if not suggestion_is_current(str(suggestion.get("id", ""))):
        return
    if direct:
        # Hold-to-talk has no editor to recover into. Keep the response surface
        # closed when no answer was produced instead of showing an error card.
        clear_suggestion()
        return
    suggestion.update({
        "body": "I couldn't get a local response. Edit the request and try again.",
        "awaitingInput": not direct,
        "streaming": False,
        "held": not direct,
    })
    atomic_write_json(SUGGESTION_FILE, suggestion)


def ask_assistant(config: dict[str, dict[str, Any]], request: str) -> str:
    request = bounded_text(request, 2000)
    if not request:
        raise RuntimeError("write or dictate a request first")
    suggestion = current_suggestion()
    source_mode = suggestion.get("mode")
    if source_mode not in {"summon", "voice"}:
        raise RuntimeError("summon Local AI before asking a direct question")

    direct = source_mode == "voice"
    now = int(time.time())
    suggestion.update({
        # Voice mode is deliberately retained until the first model token so
        # the floating response window does not appear while Pi is loading.
        "mode": "voice" if direct else "summon",
        "title": "Local AI",
        "request": request,
        "body": "" if direct else "Starting local model…",
        "copyText": "",
        "delegatePrompt": "",
        "awaitingInput": False,
        "streaming": True,
        "held": not direct,
        "expiresAt": now + int(config["observer"]["suggestion_ttl_sec"]),
    })
    atomic_write_json(SUGGESTION_FILE, suggestion)
    try:
        command, environment, model_id, context_window = pi_invocation(
            config,
            SYSTEM_PROMPT_FILE.read_text(encoding="utf-8"),
            {
                "interaction_mode": "direct",
                "request": request,
                "active_window": suggestion.get("context") or {},
            },
        )
    except Exception:
        mark_ask_failed(suggestion, direct=direct)
        raise
    if not suggestion_is_current(str(suggestion["id"])):
        return ""
    write_status("thinking", model=model_id, endpoint=config["runtime"]["endpoint"], contextWindow=context_window)
    try:
        process = subprocess.Popen(
            command,
            cwd=STATE_DIR,
            env=environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            bufsize=0,
        )
    except OSError:
        mark_ask_failed(suggestion, direct=direct)
        raise
    if process.stdout is None or process.stderr is None:
        process.kill()
        mark_ask_failed(suggestion, direct=direct)
        raise RuntimeError("Pi streaming pipes were unavailable")

    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ, "stdout")
    selector.register(process.stderr, selectors.EVENT_READ, "stderr")
    decoders = {
        "stdout": codecs.getincrementaldecoder("utf-8")("replace"),
        "stderr": codecs.getincrementaldecoder("utf-8")("replace"),
    }
    output = ""
    errors = ""
    last_update = 0.0
    deadline = time.monotonic() + max(60.0, float(config["observer"]["inference_timeout_sec"]))
    try:
        while selector.get_map():
            if time.monotonic() >= deadline:
                process.terminate()
                try:
                    process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    process.kill()
                mark_ask_failed(suggestion, direct=direct)
                raise RuntimeError("local response timed out")
            for key, _ in selector.select(timeout=0.08):
                chunk = os.read(key.fd, 4096)
                stream = str(key.data)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                decoded = decoders[stream].decode(chunk)
                if stream == "stdout":
                    output = (output + decoded)[:6000]
                else:
                    errors = (errors + decoded)[-2000:]
            now = time.monotonic()
            if output.strip() and now - last_update >= 0.08:
                if not suggestion_is_current(str(suggestion["id"])):
                    process.terminate()
                    try:
                        process.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        process.kill()
                    return ""
                if direct and suggestion.get("mode") == "voice":
                    suggestion["mode"] = "direct"
                    suggestion["held"] = False
                    suggestion["expiresAt"] = int(time.time()) + int(
                        config["observer"]["suggestion_ttl_sec"]
                    )
                suggestion["body"] = output.strip()
                atomic_write_json(SUGGESTION_FILE, suggestion)
                last_update = now
        output += decoders["stdout"].decode(b"", final=True)
        errors += decoders["stderr"].decode(b"", final=True)
        return_code = process.wait(timeout=2)
    finally:
        selector.close()

    response = output.strip()
    if not suggestion_is_current(str(suggestion["id"])):
        return response
    if return_code != 0 or not response:
        mark_ask_failed(suggestion, direct=direct)
        raise RuntimeError(bounded_text(errors or "Pi returned no response", 500))

    now = int(time.time())
    suggestion.update({
        "mode": "direct" if direct else "summon",
        "body": response[:6000],
        "copyText": response[:6000],
        "delegatePrompt": bounded_text(
            f"Continue this request in the full agent harness: {request}\n\nLocal assistant response: {response}", 1000
        ),
        "awaitingInput": False,
        "streaming": False,
        "expiresAt": now + int(config["observer"]["suggestion_ttl_sec"]),
    })
    atomic_write_json(SUGGESTION_FILE, suggestion)
    append_audit("answered", suggestion)
    write_status("suggesting", model=model_id, endpoint=config["runtime"]["endpoint"], contextWindow=context_window)
    return response


def evaluate_context(config: dict[str, dict[str, Any]], context: dict[str, str]) -> dict[str, Any] | None:
    if not context_is_actionable(config, context):
        clear_suggestion()
        append_audit("skipped", None, reason="insufficient-context")
        write_status("watching", endpoint=config["runtime"]["endpoint"])
        return None
    if suggestions_last_hour() >= int(config["observer"]["max_suggestions_per_hour"]):
        write_status("watching", lastError="Hourly suggestion limit reached")
        clear_suggestion()
        return None
    write_status("thinking", endpoint=config["runtime"]["endpoint"])
    raw = run_pi(config, context)
    suggestion = normalized_suggestion(raw, context, config)
    if suggestion is None:
        clear_suggestion()
        append_audit("skipped", None, confidence=float(raw.get("confidence", 0) or 0))
        write_status("watching", endpoint=config["runtime"]["endpoint"])
        return None
    atomic_write_json(SUGGESTION_FILE, suggestion)
    append_audit("shown", suggestion, confidence=suggestion["confidence"])
    write_status("suggesting", endpoint=config["runtime"]["endpoint"])
    return suggestion


def control_state() -> dict[str, Any]:
    value = read_json(CONTROL_FILE, {"paused": False, "snoozedUntil": 0})
