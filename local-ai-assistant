def doctor(config_path: Path, online: bool) -> dict[str, Any]:
    checks: dict[str, dict[str, Any]] = {}
    try:
        config = load_config(config_path)
        checks["config"] = {"ok": True, "detail": str(config_path)}
    except ConfigError as error:
        return {"ok": False, "checks": {"config": {"ok": False, "detail": str(error)}}}
    for label, env_name, fallback in (
        ("pi", "LOCAL_AI_ASSISTANT_PI", "pi"),
        ("hyprctl", "LOCAL_AI_ASSISTANT_HYPRCTL", "hyprctl"),
        ("systemctl", "LOCAL_AI_ASSISTANT_SYSTEMCTL", "systemctl"),
    ):
        executable = command_argv(env_name, fallback)[0]
        available = shutil.which(executable) is not None or Path(executable).is_file()
        checks[label] = {"ok": available, "detail": executable}
    checks["systemPrompt"] = {"ok": SYSTEM_PROMPT_FILE.is_file(), "detail": str(SYSTEM_PROMPT_FILE)}
    if online:
        try:
            model_id, context = sync_pi_catalog(config)
            checks["runtime"] = {"ok": True, "detail": f"{model_id} · {context} tokens"}
        except Exception as error:
            checks["runtime"] = {"ok": False, "detail": bounded_text(error, 500)}
    return {"ok": all(check["ok"] for check in checks.values()), "checks": checks}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=Path(os.environ.get("LOCAL_AI_ASSISTANT_CONFIG", DEFAULT_CONFIG)))
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("status")
    subparsers.add_parser("setup-state")
    subparsers.add_parser("apps")
    configure_parser = subparsers.add_parser("configure")
    configure_parser.add_argument("model_choice")
    configure_parser.add_argument("minimum_confidence")
    configure_parser.add_argument("share_window_title")
    configure_parser.add_argument("blocked_apps", nargs="?", default="[]")
    configure_parser.add_argument("preferred_harness", nargs="?", default="")
    doctor_parser = subparsers.add_parser("doctor")
    doctor_parser.add_argument("--online", action="store_true")
    subparsers.add_parser("render-service")
    subparsers.add_parser("install-service")
    subparsers.add_parser("enable")
    subparsers.add_parser("disable")
    subparsers.add_parser("restart")
    subparsers.add_parser("pause")
    subparsers.add_parser("resume")
    subparsers.add_parser("dismiss")
    subparsers.add_parser("clear-feedback")
    subparsers.add_parser("open-memory")
    subparsers.add_parser("copy")
    subparsers.add_parser("remember")
    subparsers.add_parser("hold-suggestion")
    subparsers.add_parser("release-suggestion")
    subparsers.add_parser("prepare-window")
    subparsers.add_parser("place-window")
    subparsers.add_parser("summon")
    subparsers.add_parser("voice-start")
    subparsers.add_parser("voice-stop")
    ask_parser = subparsers.add_parser("ask")
    ask_parser.add_argument("request")
    delegate_parser = subparsers.add_parser("delegate")
    delegate_parser.add_argument("harness", nargs="?", default="")
    subparsers.add_parser("edit-settings")
    subparsers.add_parser("open-playbook")
    subparsers.add_parser("test-suggestion")
    evaluate_parser = subparsers.add_parser("evaluate")
    evaluate_parser.add_argument("--context-json", required=True)
    subparsers.add_parser("run")
    args = parser.parse_args()
    config_path = args.config.expanduser().resolve()

    try:
        if args.command == "status":
            print(json.dumps(status_payload(config_path), ensure_ascii=False, separators=(",", ":")))
        elif args.command == "setup-state":
            print(json.dumps(setup_payload(config_path), ensure_ascii=False, separators=(",", ":")))
        elif args.command == "apps":
            print(json.dumps(installed_app_options(), ensure_ascii=False))
        elif args.command == "configure":
            configure_from_ui(
                config_path,
                args.model_choice,
                args.minimum_confidence,
                args.share_window_title,
                args.blocked_apps,
                args.preferred_harness,
            )
            print("configured")
        elif args.command == "doctor":
            result = doctor(config_path, args.online)
            print(json.dumps(result, ensure_ascii=False, indent=2))
            return 0 if result["ok"] else 1
        elif args.command == "render-service":
            load_config(config_path)
            print(service_unit(config_path), end="")
        elif args.command == "install-service":
            print(install_service(config_path))
        elif args.command == "enable":
            install_service(config_path)
            result = systemctl("enable", "--now", UNIT_NAME)
            if result.returncode != 0:
                raise RuntimeError(result.stderr.strip() or "could not enable Assistant service")
            print("enabled")
        elif args.command == "disable":
            result = systemctl("disable", "--now", UNIT_NAME)
            if result.returncode != 0 and "does not exist" not in result.stderr:
                raise RuntimeError(result.stderr.strip() or "could not disable Assistant service")
            clear_suggestion()
            write_status("stopped")
            print("disabled")
        elif args.command == "restart":
            result = systemctl("restart", UNIT_NAME)
            if result.returncode != 0:
                raise RuntimeError(result.stderr.strip() or "could not restart Assistant service")
            print("restarted")
        elif args.command == "pause":
            set_control(paused=True)
            clear_suggestion()
            write_status("paused")
            print("paused")
        elif args.command == "resume":
            set_control(paused=False, snoozedUntil=0)
            write_status("watching")
            print("resumed")
        elif args.command == "dismiss":
            suggestion = current_suggestion()
            remember_dismissed_suggestion(suggestion)
            append_audit("dismissed", suggestion)
            clear_suggestion()
            print("dismissed")
        elif args.command == "clear-feedback":
            atomic_write_json(FEEDBACK_FILE, {"version": 1, "examples": []})
            sync_memory_file()
            print("feedback cleared")
        elif args.command == "open-memory":
            open_memory()
            print(str(MEMORY_FILE))
        elif args.command == "copy":
            suggestion = current_suggestion()
            completed = subprocess.run(["wl-copy"], input=str(suggestion.get("copyText") or suggestion.get("body") or ""), text=True)
            if completed.returncode != 0:
                raise RuntimeError("wl-copy failed")
            append_audit("copied", suggestion)
            print("copied")
        elif args.command == "remember":
            config = load_config(config_path)
            suggestion = current_suggestion()
            remember_suggestion(config, suggestion)
            append_audit("remembered", suggestion)
            clear_suggestion()
            print("remembered")
        elif args.command == "hold-suggestion":
            config = load_config(config_path)
            set_suggestion_held(config, True)
            print("held")
        elif args.command == "release-suggestion":
            config = load_config(config_path)
            set_suggestion_held(config, False)
            print("released")
        elif args.command == "prepare-window":
            prepare_suggestion_window()
            print("prepared")
        elif args.command == "place-window":
            place_suggestion_window()
            print("placed")
        elif args.command == "summon":
            config = load_config(config_path)
            summon_assistant(config)
            print("summoned")
        elif args.command == "voice-start":
            config = load_config(config_path)
            voice_start(config)
            print("listening")
        elif args.command == "voice-stop":
            config = load_config(config_path)
            voice_stop(config)
            print("submitted")
        elif args.command == "ask":
            config = load_config(config_path)
            ask_assistant(config, args.request)
            print("answered")
        elif args.command == "delegate":
            config = load_config(config_path)
            suggestion = current_suggestion()
            harness = args.harness or resolved_preferred_harness(config)
            if not harness:
                raise RuntimeError("choose an installed preferred harness in Settings")
            handoff_path = create_handoff_session(suggestion, harness)
            copy_handoff_path(handoff_path)
            launch_handoff(config, harness, handoff_path, suggestion)
            append_audit("delegated", suggestion, harness=harness, handoffPath=str(handoff_path))
            clear_suggestion()
            print(str(handoff_path))
        elif args.command == "edit-settings":
            open_settings(config_path)
        elif args.command == "open-playbook":
            config = load_config(config_path)
            launch_editor(expand_path(config["playbook"]["path"]))
        elif args.command == "test-suggestion":
            config = load_config(config_path)
            now = int(time.time())
            suggestion = {
                "id": str(uuid.uuid4()),
                "mode": "proactive",
                "title": "A useful next step",
                "observation": "Demo: You asked Local AI to show a suggestion card.",
                "body": "Try a quick action, or continue in your preferred harness.",
                "copyText": "Local AI's always-on assistant is ready for testing.",
                "delegatePrompt": "Review the Local AI always-on assistant setup and report any issues. Do not edit files.",
                "confidence": 1.0,
                "createdAt": now,
                "expiresAt": now + int(config["observer"]["suggestion_ttl_sec"]),
                "workingDirectory": suggestion_working_directory(),
                "context": {"appId": "Local AI", "title": "Suggestion card demo", "workspace": ""},
            }
            atomic_write_json(SUGGESTION_FILE, suggestion)
            append_audit("shown", suggestion, test=True)
            print("shown")
        elif args.command == "evaluate":
            config = load_config(config_path)
            context = json.loads(args.context_json)
            if not isinstance(context, dict):
                raise RuntimeError("context must be a JSON object")
            result = evaluate_context(config, {key: bounded_text(context.get(key), 200) for key in ("appId", "title", "workspace")})
            print(json.dumps(result or {}, ensure_ascii=False, separators=(",", ":")))
        elif args.command == "run":
            return run_daemon(config_path)
    except (ConfigError, RuntimeError, OSError, subprocess.SubprocessError, json.JSONDecodeError, urllib.error.URLError) as error:
        print(f"local-ai-assistant: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
