{
  "schemaVersion": 1,
  "id": "io.github.gustavonline.local-ai",
  "name": "Local AI",
  "version": "0.3.0",
  "author": "Gustav Andersen",
  "license": "MIT",
  "description": "Start, stop, switch, and inspect prepared llama.cpp profiles from the Omarchy bar.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Local AI",
    "description": "Control prepared llama.cpp systemd user services without opening a terminal.",
    "category": "AI",
    "aliases": ["local-ai", "llama.cpp", "models", "runtime"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "localConfigFile": "~/.config/omarchy/local-ai.toml",
      "refreshIntervalSec": 10
    },
    "schema": [
      {
        "key": "localConfigFile",
        "type": "path",
        "label": "llama.cpp profiles",
        "defaultValue": "~/.config/omarchy/local-ai.toml",
        "description": "TOML index of prepared llama.cpp systemd user services."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 10
      }
    ]
  }
}
